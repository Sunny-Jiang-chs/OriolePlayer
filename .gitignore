# Track the player through an explicit allowlist. New folders stay local by default.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/THIRD_PARTY_NOTICES.md
!/package.json
!/index.html
!/server.mjs
!/Start.cmd
!/start.ps1
!/Start-Organizer.cmd
!/start-organizer.ps1
!/shared-lock.json
!/Start-Android.cmd
!/start-android.ps1
!/Build-Android.cmd
!/build-android.ps1
!/player/
!/schema/
!/docs/
!/scripts/
!/android/
!/datasets/
!/assets/

/assets/*
!/assets/branding/
/assets/branding/*
!/assets/branding/huangli-player-icon-v1.png
!/assets/branding/huangli-player-icon-v1.prompt.txt
!/assets/branding/README.md

/docs/*
!/docs/ANDROID.md
!/docs/ARCHITECTURE.md
/scripts/*
!/scripts/package-dataset.py
!/scripts/package-release.py
!/scripts/artifact_store.py
!/scripts/artifact_store_test.py
!/docs/VERSIONS.md
/datasets/*
!/datasets/index.json
!/datasets/example/
/datasets/example/*
!/datasets/example/package.json
!/datasets/example/README.md
!/datasets/example/build_example.py
!/datasets/example/media/
/datasets/example/media/*
!/datasets/example/media/station-day.png
!/datasets/example/media/station-evening.png
!/datasets/example/media/quiet-platform.wav
!/datasets/example/media/arrival.wav

**/__pycache__/
*.pyc
**/node_modules/
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.jks
*.keystore
.env
.env.*
